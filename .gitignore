# Scopus-derived data: not redistributed (licensing restrictions). Only the
# code/ scripts in each data/NN_stage/ folder are tracked; rerun the
# pipeline against your own Scopus-licensed data pull to reproduce input/
# and output/. The folders themselves are kept (via .gitkeep) so the
# expected pipeline layout is still visible.
data/*/input/*
data/*/output/*
!data/*/input/.gitkeep
!data/*/output/.gitkeep

# All PDFs: third-party reference papers in references/ are copyrighted
# and not redistributed; paper/paper.pdf is a compiled build artifact --
# regenerate it with `quarto render paper/paper.qmd`.
*.pdf

# Quarto book build output/cache (regenerate with `quarto render logbook/`)
logbook/_book/
logbook/.quarto/

# Make build-state stamps (local build state only; a fresh clone should
# rebuild everything for real rather than trusting someone else's stamps)
.stamp_*

# Python virtual environment
.venv/

# LaTeX build artifacts
*.aux
*.auxlock
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.dpth
*.md5

# OS files
.DS_Store

# IDE / local tool settings (personal, machine-specific)
.vscode/
.claude/
